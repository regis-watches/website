# Copy this file to .env and fill it in. Never commit .env. Never put these values in front-end code.

# development | production. Use separate values and separate databases for each.
APP_ENV=development
SITE_URL=http://localhost:8000

# Shared secret between the four services (they only listen on 127.0.0.1).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_TOKEN=

# The business owner's admin login, created on first start. Use a long, unique password (12+ characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Paystack. Leave the key empty in development to use the built-in test checkout (nothing real is charged).
# In production use your LIVE secret key (sk_live_...). Only the Rust payments service reads this.
PAYSTACK_SECRET_KEY=

# Email (C# mailer). Leave SMTP_HOST empty in development: emails are saved as HTML files in data/outbox instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SSL=true
MAIL_FROM=Regis <orders@yourdomain.ng>

# Shown on the Contact page, footer and in the legal pages.
BUSINESS_NAME=Regis
SUPPORT_EMAIL=inbox.regis@gmail.com
SUPPORT_PHONE=
SUPPORT_WHATSAPP=

# Optional. Plausible analytics domain (loaded only after the visitor agrees). Sentry error monitoring DSN.
PLAUSIBLE_DOMAIN=
SENTRY_DSN=

# Optional Paystack fee estimate settings (used only if Paystack does not report the real fee).
# Defaults match Paystack's local card pricing: 1.5% + N100, flat part waived under N2,500, capped at N2,000.
# PAYSTACK_FEE_BP=150
# PAYSTACK_FEE_FLAT_KOBO=10000
# PAYSTACK_FEE_WAIVE_BELOW_KOBO=250000
# PAYSTACK_FEE_CAP_KOBO=200000
